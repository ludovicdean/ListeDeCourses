{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "liste-de-courses": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true,
          "path": "src/app/features"
        },
        "@schematics/angular:class": {
          "skipTests": true,
          "path": "src/app/core"
        },
        "@schematics/angular:directive": {
          "skipTests": true,
          "path": "src/app/shared"
        },
        "@schematics/angular:guard": {
          "skipTests": true,
          "path": "src/app/core/guards"
        },
        "@schematics/angular:interceptor": {
          "skipTests": true,
          "path": "src/app/core"
        },
        "@schematics/angular:pipe": {
          "skipTests": true,
          "path": "src/app/shared"
        },
        "@schematics/angular:resolver": {
          "skipTests": true,
          "path": "src/app/core"
        },
        "@schematics/angular:service": {
          "skipTests": true,
          "path": "src/app/core/services"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@sqlite.org/sqlite-wasm/dist",
                "output": "assets/sqlite-wasm"
              }
            ],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "headers": {
              "Cross-Origin-Embedder-Policy": "require-corp",
              "Cross-Origin-Opener-Policy": "same-origin"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "liste-de-courses:build:production"
            },
            "development": {
              "buildTarget": "liste-de-courses:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "liste-de-courses:build:development"
          }
        }
      }
    }
  }
}
